---
layout: base.njk
---
<article>
  <header class="eyecatch{% if image %} has-image{% endif %}"{% if image %} style="--eyecatch-image: url('{{ image }}'); --eyecatch-pos: {{ imagePosition or '65% 50%' }}"{% endif %}>
    <p class="label">{{ site.category }}</p>
    {% set titleParts = title.split("｜") %}
    <h1>{{ titleParts[0] }}{% if titleParts[1] %}<span class="subtitle">{{ titleParts[1] }}</span>{% endif %}</h1>
    <div class="eyecatch-logo" aria-hidden="true">{% include "logo-kdr.svg" %}</div>
  </header>
  {% if imageCredit %}<p class="image-credit">{% if imageCreditUrl %}<a href="{{ imageCreditUrl }}" rel="noopener" target="_blank">{{ imageCredit }}</a>{% else %}{{ imageCredit }}{% endif %}</p>{% endif %}
  <p class="meta">
    公開：{{ page.date | jpDate }}
    {% if updated %}／ 更新：{{ updated | jpDate }}{% endif %}
  </p>
  {% if hasAds %}<p class="pr-notice">この記事には広告（アフィリエイトリンク）が含まれます。</p>{% endif %}

  {{ content | safe }}

  {% if sources %}
  <section class="sources">
    <h2>参考にした情報</h2>
    <ul>
      {% for s in sources %}
      <li><a href="{{ s.url }}" rel="noopener" target="_blank">{{ s.name }}</a>（{{ s.checked }} 確認）</li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}
</article>
