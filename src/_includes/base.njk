<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} | {% endif %}{{ site.name }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+JP:wght@400;500;700&family=Saira:wght@300;500;600&display=swap">
  <link rel="stylesheet" href="/css/style.css?v={{ buildTime }}">
  <style>:root { --accent: {{ site.accent }}; --accent-dark: {{ site.accentDark }}; }</style>
</head>
<body class="car-root">
  <header class="site-header">
    <div class="site-header-inner">
      <a class="brand" href="/" aria-label="{{ site.name }} トップへ">{% include "logo-kdr.svg" %}</a>
      <nav>
        <a class="nav-link" href="/#notes"><span class="en" lang="en">Notes</span><span class="ja">記事</span></a>
        <a class="nav-link" href="/about/"><span class="en" lang="en">About</span><span class="ja">運営者</span></a>
      </nav>
    </div>
  </header>
  <main>
    {{ content | safe }}
  </main>
  <footer class="site-footer">
    <div class="site-footer-inner">
      <a class="footer-logo" href="/" aria-label="トップへ">{% include "logo-kdr.svg" %}</a>
      <nav>
        <a href="/">トップ</a>
        <a href="/about/">運営者情報・広告について</a>
      </nav>
      <p>&copy; {{ site.author }}</p>
    </div>
  </footer>
</body>
</html>
