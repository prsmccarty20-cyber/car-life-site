---
layout: base.njk
---
<section class="hero{% if site.heroImage %} has-image{% endif %}">
  {% if site.heroImage %}<img class="hero-image" src="{{ site.heroImage }}" alt="" width="1600" height="1245">{% endif %}
  <div class="hero-text">
    <p class="label">{{ site.category }}</p>
    <h1>{{ site.name }}</h1>
    <p>{{ site.description }}</p>
  </div>
</section>

<h2 class="section-title">新しい記事</h2>
{% if collections.articles.length %}
<ul class="card-list">
  {% for a in collections.articles %}
  {% set parts = a.data.title.split("｜") %}
  <li class="card">
    <a href="{{ a.url }}">
      <span class="card-thumb"{% if a.data.image %} style="background-image: url('{{ a.data.image }}'); background-position: {{ a.data.imagePosition or '65% 50%' }}"{% endif %}>
        {% if not a.data.image %}<span class="card-thumb-logo" aria-hidden="true">{% include "logo-kdr.svg" %}</span>{% endif %}
      </span>
      <span class="card-body">
        <span class="card-title">{{ parts[0] }}</span>
        {% if parts[1] %}<span class="card-sub">{{ parts[1] }}</span>{% endif %}
        <span class="meta">{{ a.date | jpDate }}</span>
      </span>
    </a>
  </li>
  {% endfor %}
</ul>
{% else %}
<p>記事は準備中です。もう少しお待ちください。</p>
{% endif %}
